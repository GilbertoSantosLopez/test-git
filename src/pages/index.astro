---
import Navbar from '../components/Navbar'
import InteractiveCards from '../components/InteractiveCards'
import '../styles/global.css'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta
      name="description"
      content="Práctica de Astro, React, TypeScript y Tailwind CSS"
    />

    <title>Astro + React</title>
  </head>

  <body class="min-h-screen bg-slate-950 text-white">
    <Navbar
      brand="Frontend Lab"
      subtitle="Astro + React + TypeScript"
    />

    <main>
      <InteractiveCards client:load />
    </main>
  </body>
</html>